# Copy to .env (never commit .env) and fill in the key.
# Without a key the panel works and the assistant answers with rule-based fallbacks.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# groq (default) · openai_compat (Ollama or another OpenAI-compatible server) · fake (offline)
LLM_PROVIDER=groq
# empty = provider default (groq: openai/gpt-oss-120b)
LLM_MODEL=
# empty = provider default (groq: https://api.groq.com/openai/v1 · Ollama: http://host.docker.internal:11434/v1)
LLM_BASE_URL=
# free → real cost US$ 0 (the panel also shows the equivalent paid cost) · paid
LLM_PLAN=free
