# Copy to .env (never commit .env) and fill in the key.
# Without a key the panel works and the assistant answers with rule-based fallbacks.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# groq (default) · openai_compat (Ollama or another OpenAI-compatible server) · fake (offline)
LLM_PROVIDER=groq
# empty = provider default (groq: openai/gpt-oss-120b)
LLM_MODEL=
# Optional deployment-only override for openai_compat. Groq uses its fixed HTTPS endpoint.
LLM_BASE_URL=
LLM_API_KEY=
# free → real cost US$ 0 (the panel also shows the equivalent paid cost) · paid
LLM_PLAN=free
LLM_DAILY_TOKENS=200000
LLM_DAILY_USD=1

# local = loopback only · auth = browser login with roles
DEMO_ACCESS=local
DEMO_PORT=8000
# Set the exact public HTTPS origin when using a trusted reverse proxy.
DEMO_ORIGIN=
# Optional accounts named viewer, operator and admin. Use distinct random passwords (16+ characters).
DEMO_VIEWER_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Use only in a dedicated demonstration environment.
DEMO_FAULTS=0
